{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["whatsapp.js", "whatsapp", "models", "hue", "joplin", "data", "scripts", "tools", "eval"]
}
