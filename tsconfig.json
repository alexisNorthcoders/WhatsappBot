{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"]
}
