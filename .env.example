# WhatsappBot environment (copy to `.env` and fill in secrets).
# This file documents optional / scheduled features; not all vars are required.

# Owner WhatsApp number (digits or full JID). Required for cron jobs that notify you.
# MY_PHONE=
# SECOND_PHONE=

# --- agent-runner (out-of-process Claude agent, docs/adr/0001-agent-runner-out-of-process.md) ---
# Every `claude…` message (after the allowlist check) is forwarded to agent-runner's localhost API,
# and `!restart` refuses while a runner run is active. The Claude pipeline, the cron issue tracer
# and their settings (workspaces, post-run flags, pause, model) live in agent-runner's `.env`.
# The bot delivers the runner's Redis Stream outbox (`agent-runner:outbox`, via REDIS_URL),
# merging whatever is waiting into one message per chat. Messages that arrived while the bot was
# down aren't replayed: you get one "you missed N" line, and `claude:missed` lists them.
# Default http://127.0.0.1:3790.
# AGENT_RUNNER_URL=http://127.0.0.1:3790
# How often the outbox is polled, in ms. Default 5000.
# AGENT_RUNNER_OUTBOX_POLL_MS=5000
# Redis for the outbox cursor (and CHAT_MEMORY_BACKEND=redis, if enabled). Default redis://127.0.0.1:6379.
# REDIS_URL=redis://127.0.0.1:6379

# --- Reddit-bot daily cron digest (issue #61) ---
# Companion: reddit-bot `npm run cron_digest` writes reports/daily-cron-status.txt
# (~02:45 UTC). WhatsappBot polls from REDDIT_CRON_DIGEST_HOUR_UTC and sends once
# the file is fresh and stamped for today's UTC day. Missing/stale alerts fire at
# most once/day and do not block a later digest send when the file arrives.
# Schedule is UTC to match reddit-bot user crontab (CRON_TZ=UTC).
# REDDIT_BOT_STATUS_FILE=/home/alexis/Projects/reddit-bot/reports/daily-cron-status.txt
# REDDIT_CRON_DIGEST_HOUR_UTC=3
# REDDIT_CRON_DIGEST_MINUTE_UTC=0
# REDDIT_CRON_DIGEST_POLL_MS=60000
# REDDIT_CRON_DIGEST_DISABLE=1
# REDDIT_CRON_DIGEST_ALSO_SECOND_PHONE=1
# REDDIT_CRON_DIGEST_LAST_SENT_FILE=/home/alexis/Projects/WhatsappBot/logs/claude-agent/reddit-cron-digest-last-sent.json
# (default kept under logs/claude-agent/ for continuity; deleting that folder only resets this marker)

# --- Home manuals Q&A (issue #98) ---
# Base URL of the home-manuals service (alexisNorthcoders/home-manuals). `home <question>`
# and natural-language home questions (routed through homeAgent) POST { question } to
# `${HOME_MANUALS_URL}/ask` and expect { answer, sources } back. Unset: the `home` command
# explains it's not configured, and homeAgent skips (falls through to normal chat) silently.
# HOME_MANUALS_URL=http://127.0.0.1:3100
# Always route through homeAgent, bypassing the keyword gate (debugging only).
# HOME_AGENT_ALWAYS=1

# --- Book recommendations (issue #118) ---
# Base URL of reddit-bot's recommendation service. Book requests from MY_PHONE / SECOND_PHONE
# (routed through bookAgent) POST { question } to `${BOOK_RECS_URL}/ask` (15s timeout) and send
# back its `answer` as is. `not_a_request` falls through to the other handlers; an error or
# timeout replies "unavailable". Unset: bookAgent skips silently.
# BOOK_RECS_URL=http://127.0.0.1:3200
# Always route through bookAgent, bypassing the keyword gate (debugging only).
# BOOK_AGENT_ALWAYS=1

# --- Jev agent routing (TypeSafe) ---
# When set, one TypeSafe Jev Choice call picks which agent (reminder/lights/weather/joplin/
# email/home/books) handles a non-command message, or plain chat, instead of the per-agent keyword
# gates + SKIP fallthrough. Unset, or Jev unreachable/erroring: the keyword gates are used.
# TYPESAFE_API_KEY=
# JEV_ROUTER_MODEL=jev-latest
# JEV_ROUTER_TIMEOUT_MS=3000
# Below this probability for the chosen agent, the message goes to chat instead.
# JEV_ROUTER_MIN_PROBABILITY=0.5
# Simple light requests (on/off/brightness/colour/list for one light, one room or all) are
# answered from the same Jev call and sent straight to the Hue bridge, no GPT call. Every answer
# used must reach this probability, else the GPT lights agent handles it.
# LIGHTS_JEV_MIN_PROBABILITY=0.7
# LIGHTS_JEV_DISABLE=1

# --- Calendar nudges: Owner's calendar → WhatsApp (issues #125/#126, ADR 0002) ---
# Nudges the owner (MY_PHONE's chat) at each Alert time of timed and all-day events on their
# primary Google Calendar. Off unless all three OAuth values are set; setup and the one-time
# consent step (npm run calendar:consent) are in docs/google-calendar-setup.md.
# This calendar is the only reminder store (#128): without these, the reminder agent only
# answers "reminder help". With them, WhatsApp can add ("remind me…", "dentist Friday 3pm"),
# list ("what's on tomorrow", "list reminders") and cancel ("cancel 2") Reminders.
# GOOGLE_CALENDAR_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-...
# GOOGLE_CALENDAR_REFRESH_TOKEN=1//0g...
# GOOGLE_CALENDAR_CONSENT_PORT=53682
# CALENDAR_NUDGES_DISABLE=1
# CALENDAR_NUDGES_POLL_MS=60000
# All-day Reminders without explicit notifications Nudge once that day at this local time
# (calendar's timezone, HH:MM 24 h). Ones with explicit notifications Nudge at those instead.
# CALENDAR_ALLDAY_NUDGE_TIME=09:00
# Length of Reminders created from WhatsApp when the message gives no end or duration.
# CALENDAR_DEFAULT_DURATION_MIN=15
# Nudged log: (event, occurrence start, alert offset) already sent; pruned once the occurrence ends.
# CALENDAR_NUDGED_LOG_FILE=/home/alexis/Projects/WhatsappBot/logs/reminders/nudged.json

# --- Access control (whatsapp/whatsAppActorAllowlist.js) ---
# Extra comma-separated JIDs allowed to use `claude…` and `!restart`, for @lid identities that
# can't be matched to MY_PHONE / SECOND_PHONE.
# CLAUDE_AGENT_EXTRA_JIDS=123456789012345@lid

# --- API keys ---
# OPENAI_API_KEY=
# DEEPINFRA_API_KEY=
# OPENWEATHER_API_KEY=

# --- Chat fallback (OpenAI assistant, models/models.js + whatsapp/chatMemory.js) ---
# OPENAI_CHAT_MODEL=gpt-5-mini
# Unset: a per-model default.
# OPENAI_ASSISTANT_MAX_COMPLETION_TOKENS=
# `redis` keeps per-chat memory in REDIS_URL across restarts; default `memory` (in-process).
# CHAT_MEMORY_BACKEND=memory
# CHAT_MEMORY_MAX_MESSAGES=10
# CHAT_MEMORY_MAX_CONTENT=4000

# --- NL agents (whatsapp/agents/) ---
# *_AGENT_ALWAYS=1 bypasses the agent's keyword gate (debugging only).
# LIGHTS_AGENT_MODEL=gpt-5-nano
# LIGHTS_AGENT_ALWAYS=1
# WEATHER_AGENT_MODEL=gpt-5-nano
# WEATHER_AGENT_DEFAULT_CITY=Manchester
# WEATHER_AGENT_ALWAYS=1
# JOPLIN_AGENT_MODEL=gpt-5-nano
# Notebook the Joplin agent writes to. Default "WhatsApp Bot".
# JOPLIN_AGENT_NOTEBOOK=WhatsApp Bot
# JOPLIN_AGENT_ALWAYS=1
# EMAIL_AGENT_MODEL=gpt-5-nano
# EMAIL_AGENT_ALWAYS=1
# Gmail account the email agent sends from (an app password, not the account password).
# GMAIL_EMAIL=
# GMAIL_PASSWORD=
# CSV of agent LLM calls and token counts. Default logs/agent-usage.csv.
# AGENT_USAGE_LOG=logs/agent-usage.csv

# --- Philips Hue bridge (hue/) ---
# HUE_IP=192.168.1.2
# HUE_USERNAME=

# --- Joplin Server (joplin/) ---
# JOPLIN_SERVER_URL=
# JOPLIN_EMAIL=
# JOPLIN_PASSWORD=

# --- URL fetching limits (summarize, Joplin, home manuals; whatsapp/utils/urlFetchSafety.js) ---
# BOT_FETCH_TIMEOUT_MS=45000
# BOT_FETCH_MAX_REDIRECTS=10
# BOT_FETCH_MAX_RESPONSE_BYTES=12582912
# JOPLIN_FETCH_MAX_HTML_CHARS=500000

# --- summarize command ---
# SUMMARIZE_MAX_INPUT_CHARS=24000
# Only one summarize runs at a time; a run still going after this many ms is aborted (max 3600000).
# SUMMARIZE_LOCK_TTL_MS=600000
# LOG_LEVEL=info

# --- Image iteration (`sprite+` / `sdxl+` reuse the last image for this long, in ms) ---
# SPRITE_LAST_PATH_TTL_MS=86400000
# SDXL_LAST_PATH_TTL_MS=86400000

# --- !restart ---
# PM2_RESTART_APP_ID=0
# PM2_RESTART_DELAY_MS=800

# --- Express server for ChatAI (index.js) ---
# PORT=
# index.js defaults OPENAI_CHAT_MODEL to gpt-5-nano for its streaming route.
